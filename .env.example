# ─────────────────────────────────────────────────────────────────────────────
# True-Doctor — environment template. Copy to .env; never commit real values.
# Laravel 12 key names are used throughout (CACHE_STORE, FILESYSTEM_DISK, …).
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="True-Doctor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Serve from a domain root in production (see docs/deployment.md). A path
# suffix (e.g. http://localhost:8888/true-doctor) is supported for MAMP only.
APP_URL=http://localhost:8888/true-doctor
APP_LOCALE=en
# Proxy IPs/CIDRs (comma-separated) or * behind a managed load balancer.
TRUSTED_PROXIES=
# HMAC pepper for prepaid-card lookups (defaults to APP_KEY).
CARD_HASH_KEY=
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=true_doctor
DB_USERNAME=root
DB_PASSWORD=
# MAMP only:
# DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

# ── Cache / session / queue (Redis in production) ────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=true_doctor_

HORIZON_PATH=admin/horizon

# ── Mail ─────────────────────────────────────────────────────────────────────
# Locally, use `log`: the messages land in storage/logs/laravel.log and nothing
# needs credentials. Real SMTP on a development machine only costs you a failed
# login you then have to debug.
#
# MAIL_ENCRYPTION does NOTHING on Laravel 11+ — config/mail.php reads
# MAIL_SCHEME. An .env carried over from an older release can have both, and
# the one that looks like it is working is the one being ignored.
#
# Gmail refuses ordinary account passwords (535-5.7.8 BadCredentials). With
# 2-step verification on, generate an App Password and use that; without it,
# Gmail will not accept SMTP at all.
#
# Production uses the domain's own cPanel mailbox rather than Gmail, because
# mail sent as the domain passes the domain's own SPF and DKIM. Gmail sending
# as an address it does not own does not.
MAIL_MAILER=smtp
MAIL_HOST=mail.true-doctor.online
MAIL_PORT=465
MAIL_USERNAME=hello@true-doctor.online
# Quote it. A cPanel mailbox password full of brackets and plus signs is not
# a valid unquoted dotenv value, and it arrives at the SMTP server truncated.
MAIL_PASSWORD=""
# 465 = implicit TLS ("smtps"); 587 = STARTTLS ("tls")
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=hello@true-doctor.online
MAIL_FROM_NAME="${APP_NAME}"
# The name given in EHLO. Some receivers reject a greeting that does not
# match the sending domain.
MAIL_EHLO_DOMAIN=true-doctor.online

# ── Tenancy / SaaS gates ─────────────────────────────────────────────────────
# Block tenants without an access-granting subscription (EnsureSubscribed).
SUBSCRIPTION_GATE=true
# Days past `ends_at` a lapsed subscription still grants access.
SUBSCRIPTION_GRACE_DAYS=3
# Redirect the hospital owner to "Getting started" until setup is complete.
ONBOARDING_GATE=true

# ── API ──────────────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed by CORS; empty = none.
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false
# Hosts whose requests get a SESSION instead of needing a bearer token.
# Field Mode (offline) is a browser on this origin and sends no token, so if
# the host it is reached on is not here, every sync request answers 401 while
# /admin answers 200 beside it — silently, with no error anywhere.
# Empty falls back to localhost plus APP_URL's own host:port, which is right
# in development and right in production ONLY if APP_URL matches the host
# people actually type. Set it explicitly behind a proxy or a vanity domain.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=td_
SANCTUM_EXPIRATION_MINUTES=43200

# ── Payments — Flutterwave (keys from your dashboard; never commit) ──────────
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com
FLW_CURRENCY=UGX
FLW_PAYMENT_OPTIONS=card,mobilemoneyuganda,banktransfer,ussd
FLW_TIMEOUT=20

# ── Payments — Pesapal (subscription checkout; keys from your dashboard) ─────
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CURRENCY=UGX
PESAPAL_SANDBOX_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_PRODUCTION_URL=https://pay.pesapal.com/v3
PESAPAL_IPN_URL="${APP_URL}/gateway/pesapal/ipn"
PESAPAL_CALLBACK_URL="${APP_URL}/gateway/pesapal/callback"
PESAPAL_TIMEOUT=30
# THE platform exchange rate: shillings to one US dollar. Plan prices are
# stored in shillings; this converts them for a reader outside East Africa
# AND is what the Pesapal charge is computed against. One key, deliberately —
# two would let the quoted price and the charged price drift apart.
USD_TO_UGX_RATE=3800

# ── Optional integrations ────────────────────────────────────────────────────
# Live-chat widget on the marketing site.
TAWK_ENABLED=false
TAWK_ID=

# ── Developer tooling (never enable in production) ───────────────────────────
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# ── Public pricing ───────────────────────────────────────────────────
# The exchange rate lives in USD_TO_UGX_RATE above. See docs/public-site.md.
# Real IP geolocation via a third party. OFF by default — switching it on
# sends every visitor's IP address to somebody else's server.
PRICING_GEO_LOOKUP=false

# Where the public contact form sends enquiries (defaults to MAIL_FROM_ADDRESS).
MAIL_ENQUIRIES_TO=

# ── Public demonstration ─────────────────────────────────────────────
# Opens /test-login and the "Try the demo" links on the public pages, and
# lets the demo seeders run. A deliberate switch, not a side effect of
# APP_ENV — a live site wanting a public demo is a normal thing to want.
#
# Anyone can then sign in to the demonstration hospital with a password
# printed on the page. What makes that safe is tenancy (a demo account
# cannot read another hospital), the guard that stops the platform super
# admin ever getting that password, and the nightly reset below — not the
# password itself. See docs/demo-accounts.md.
DEMO_MODE=false
DEMO_HOSPITAL=general-hospital-a
# Empty and re-seed the demonstration hospital nightly, so a month of
# strangers does not leave the next visitor looking at a mess. Separate
# switch on purpose: turning the demo on must not by itself start
# something that deletes rows on a schedule.
DEMO_RESET=false
DEMO_RESET_AT=03:30
