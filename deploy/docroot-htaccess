# Apache configuration for the production document root.
#
# NOT a copy of public/.htaccess. That file has been adapted for the MAMP
# subdirectory development setup and its front-controller rule is
# `RewriteRule ^ ../index.php`, pointing one level ABOVE the document root —
# which on a real host is outside the web root entirely, and every route but
# `/` answers 400. This is the production one, and deploy.sh installs it.

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Authorization and CSRF headers survive into PHP. Sanctum and the offline
    # sync client both depend on the second one.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Trailing slashes off, unless it really is a directory.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Everything that is not a real file or directory goes to the front
    # controller — which is IN this directory, and boots the application from
    # outside the web root. See deploy/docroot-index.php.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Nothing beginning with a dot is ever served. The application lives outside
# the web root so there should be no .env here to find, but a deploy that goes
# wrong one day should fail closed rather than publish one.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Nor anything with an extension that is only ever source or data.
<FilesMatch "\.(env|sql|sqlite|log|ini|sh|bak|swp|dist|lock|json~)$">
    Require all denied
</FilesMatch>

# composer.json / package.json say what is installed and at which version,
# which is a shopping list for anybody looking for a known CVE.
<FilesMatch "^(composer|package|package-lock|yarn)\.(json|lock)$">
    Require all denied
</FilesMatch>

# Long-lived caching for the hashed build output. Vite puts a content hash in
# every filename, so a changed file is a different URL and this can never
# serve a stale one.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # The service workers must not be cached, or a device keeps running last
    # month's offline code and never learns there is newer.
    <FilesMatch "^(sw|field-sw)\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/json application/xml image/svg+xml
</IfModule>

ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
